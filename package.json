{
  "name": "omp-settings-ru",
  "version": "0.14.0",
  "description": "Русский перевод панели /settings в Oh My Pi — расширение OMP для marketplace-установки",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "narimanisakhanov-creator",
  "homepage": "https://github.com/narimanisakhanov-creator/omp-settings-ru#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narimanisakhanov-creator/omp-settings-ru.git"
  },
  "bugs": {
    "url": "https://github.com/narimanisakhanov-creator/omp-settings-ru/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "omp-plugin",
    "marketplace",
    "settings",
    "russian",
    "localization",
    "typescript"
  ],
  "files": [
    "src",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test --parallel=1",
    "typecheck": "tsc --noEmit",
    "source:export": "bun scripts/export-source.ts",
    "coverage:check": "bun scripts/check-coverage.ts",
    "drift:check": "bun scripts/diff-upstream.ts",
    "smoke": "bun scripts/smoke-extension.ts",
    "smoke:panel": "bun scripts/smoke-panel.ts",
    "smoke:installed": "bun scripts/smoke-installed-host.ts",
    "smoke:distribution": "bun scripts/distribution-smoke.ts",
    "smoke:source": "bun scripts/distribution-smoke.ts --source",
    "marketplace:catalog": "bun scripts/marketplace-catalog.ts",
    "marketplace:promote": "bun scripts/marketplace-index.ts",
    "matrix:check": "bun scripts/check-matrix.ts",
    "maintenance": "bun scripts/maintenance.ts",
    "maintenance:actions": "bun scripts/maintenance-actions.ts",
    "release:check": "bun scripts/check-release.ts",
    "readme:check": "bun scripts/readme-coverage.ts --check",
    "readme:write": "bun scripts/readme-coverage.ts --write",
    "check": "bun run typecheck && bun run test && bun run coverage:check && bun run drift:check && bun run readme:check && bun run smoke && bun run smoke:panel && bun run release:check"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.14.1 || 18.14.2 || 18.15.0",
    "@oh-my-pi/pi-utils": "18.14.1 || 18.14.2 || 18.15.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.15.0",
    "@oh-my-pi/pi-natives": "18.15.0",
    "@oh-my-pi/pi-tui": "18.15.0",
    "@oh-my-pi/pi-utils": "18.15.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2",
    "omp-host-18141": "npm:@oh-my-pi/pi-coding-agent@18.14.1",
    "omp-host-18142": "npm:@oh-my-pi/pi-coding-agent@18.14.2",
    "omp-host-18150": "npm:@oh-my-pi/pi-coding-agent@18.15.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  }
}
