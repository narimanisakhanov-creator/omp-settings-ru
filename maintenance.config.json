{
  "schemaVersion": 1,
  "repository": "narimanisakhanov-creator/omp-settings-ru",
  "requiredCheckPlatforms": [
    {"os": "windows-2025", "platform": "win32"},
    {"os": "ubuntu-24.04", "platform": "linux"},
    {"os": "macos-15", "platform": "darwin"}
  ],
  "controller": {
    "baseBranch": "main",
    "controllerLogin": "narimanisakhanov-creator",
    "controllerType": "User",
    "branchPattern": "^upgrade/omp-([0-9]+\\.[0-9]+\\.[0-9]+)$",
    "executorPaths": [
      "src/translations/ru-catalog.json",
      "src/translations/variant-review.json",
      "test/fixtures/host-snapshots/<candidate>-darwin.json",
      "test/fixtures/host-snapshots/<candidate>-linux.json",
      "test/fixtures/host-snapshots/<candidate>-win32.json",
      "test/fixtures/host-snapshots/supported-hosts.json",
      "package.json",
      "bun.lock",
      "upgrade-report.md",
      "CHANGELOG.md",
      "README.md"
    ],
    "requiredCheckTemplate": "check ({os}, {version})",
    "additionalRequiredChecks": ["hygiene"],
    "deadlinesMs": {
      "precheck": 30000,
      "command": 30000,
      "verification": 1800000,
      "release": 1200000,
      "checks": 2400000
    }
  }
}
